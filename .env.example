# Read automatically by python -m agent_framework.runner. No shell exports needed.
# CLI --provider and --llm override these defaults.
LLM_PROVIDER=lmstudio
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=               # only if server authentication is enabled
# LMSTUDIO_MAX_TOKENS=4096
# LMSTUDIO_TIMEOUT=300
# LMSTUDIO_MAX_RETRIES=2

# Hosted Groq inference
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# GROQ_MAX_RETRIES=8

# Hosted OpenAI inference (set a model available to your account)
OPENAI_MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Other local or production OpenAI-compatible inference servers
INFERENCE_MODEL=
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
# INFERENCE_MAX_TOKENS=4096
# INFERENCE_TIMEOUT=300
# INFERENCE_MAX_RETRIES=2

# Optional LLM reviewer settings, on branches that register an LLM reviewer.
# By default it uses the agent's selected provider and model.
# REVIEWER_PROVIDER=lmstudio
# REVIEWER_MODEL=openai/gpt-oss-20b
