# Host-only configuration. Copy to p5_inferencing/.env; never commit that file.
# Generate API_KEY with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=

# LM Studio backend. The loaded API identifier must match LM_STUDIO_MODEL.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=openai/gpt-oss-20b
# Set only when LM Studio's own token authentication is enabled.
LM_STUDIO_API_KEY=
PUBLIC_MODEL=openai/gpt-oss-20b

# Gateway listens on loopback only. Port must match the manual ngrok command.
GATEWAY_PORT=8000
REQUEST_TIMEOUT_SECONDS=600
QUEUE_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=2
MAX_REQUEST_BYTES=2097152
LOG_LEVEL=info

# Optional managed tunnel. Keep false when running ngrok in a separate terminal.
ENABLE_NGROK=false
NGROK_AUTHTOKEN=

# Optional direct Groq diagnostic; unrelated to the local gateway.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
